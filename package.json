{
  "name": "agetbazar",
  "private": true,
  "workspaces": ["apps/*", "services/*", "packages/*"],
  "scripts": {
    "dev": "bun run --cwd apps/web dev",
    "dev:worker": "bun run --cwd services/worker dev",
    "build": "bun run --cwd apps/web build",
    "lint": "bun run --cwd apps/web lint",
    "typecheck": "bun run --cwd apps/web typecheck && bun run --cwd services/worker typecheck",
    "check": "bun run lint && bun run typecheck",
    "migrate": "bun run --cwd apps/web migrate",
    "contracts:build": "cd contracts && forge build",
    "contracts:test": "cd contracts && forge test -vv"
  }
}
